diff --git a/src/c++/components/Words/session.hpp b/src/c++/components/Words/session.hpp
new file mode 100644
--- /dev/null
+++ b/src/c++/components/Words/session.hpp
@@ -0,0 +1,11 @@
+#pragma once
+#include "../../types/type.hpp"
+
+namespace sequencer {
+/** Reversible uint32 predictor; these shifts are part of the byte format. */
+inline Word predict_session(Word value) {
+  value ^= value << 13;
+  value ^= value >> 17;
+  return value ^ (value << 5);
+}
+} // namespace sequencer
