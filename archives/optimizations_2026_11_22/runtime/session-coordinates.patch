+it('uses related Sessions only when their complete identifiers match', () => {
+  const source = new Projection<string>(1)
+  let receiver: Projection<string> | undefined
+  try {
+    source.apply([[1], [2]])
+    source.insert('abc', 0)
+    const initial = source.sequence(true, true)
+    const removal = source.remove(1, 1, true)
+    const mask = sequenceInsertions(source.sequence()).find(
+      ([c]) => (c[5] | 0) < 0
+    )![0]
+    const step = (value: number) => {
+      value ^= value << 13
+      value ^= value >>> 17
+      return (value ^ (value << 5)) >>> 0
+    }
+    let related = false,
+      anchor = mask[0],
+      own = mask[3]
+    for (let i = 0; i < 8; ++i) {
+      anchor = step(anchor)
+      own = step(own)
+      related ||= anchor === mask[3] || own === mask[0]
+    }
+    const bytes = removal[0][0] as Uint8Array
+    expect(bytes[0]).toBe(255)
+    expect((bytes[1] & 127) === 83).toBe(related)
+    if (related) expect(bytes).toHaveLength(8)
+    receiver = new Projection<string>(
+      2,
+      decode(encode(initial)),
+      undefined,
+      true
+    )
+    expect(receiver.apply(decode(encode(removal)), true)).toBeDefined()
+    expect(receiver.values()).toEqual(source.values())
+  } finally {
+    source.destroy()
+    receiver?.destroy()
+  }
+})
