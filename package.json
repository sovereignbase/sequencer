{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/sequencer",
  "version": "1.0.0",
  "description": "A causality-encoding engine written in TypeScript and C++ to build high-performance, conflict-free replicated data types for use on the web.",
  "keywords": [
    "collaborative-editing",
    "crdt"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "INTERNALS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "configure:wasm": "emcmake cmake --preset wasm-release",
    "build": "npm run build:c++ && npm run build:ts",
    "build:ts": "tsdown",
    "build:c++": "node scripts/build-wasm.ts",
    "docs": "npm run docs:ts && npm run docs:c++",
    "docs:ts": "typedoc",
    "docs:c++": "node scripts/build-cpp-docs.ts",
    "format": "npm run format:ts && npm run format:c++",
    "format:ts": "prettier . --write",
    "format:c++": "node scripts/format-cpp.ts",
    "format:check": "npm run format:check:ts && npm run format:check:c++",
    "format:check:ts": "prettier . --check",
    "format:check:c++": "node scripts/format-cpp.ts --check",
    "typecheck": "tsc --noEmit --project test/tsconfig.json",
    "typecheck:runtime": "tsc --noEmit --project tsconfig.json",
    "test": "npm run build && npm run typecheck && node scripts/run-tests.ts",
    "test:vitest": "node scripts/run-tests.ts vitest --coverage",
    "test:unit": "node scripts/run-tests.ts vitest test/unit --coverage.enabled=false",
    "test:integration": "node scripts/run-tests.ts vitest test/integration --coverage.enabled=false",
    "test:convergence": "node scripts/run-tests.ts vitest test/convergence --coverage.enabled=false",
    "test:stress": "node scripts/run-tests.ts vitest test/stress --coverage.enabled=false",
    "test:compatibility": "npm run build:ts && node scripts/run-tests.ts compatibility",
    "bench": "npm run build:ts && node --expose-gc benchmark/index.ts",
    "bench:lifecycle": "npm run bench -- --suite lifecycle",
    "bench:throughput": "npm run bench -- --suite throughput",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@msgpack/msgpack": "^3.1.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "bun": "^1.4.3",
    "deno": "^2.9.6",
    "edge-runtime": "^4.0.1",
    "fast-check": "^4.10.2",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "tsdown": "^0.23.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0",
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/sequencer.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/sequencer/issues"
  },
  "homepage": "https://sovereignbase.dev/sequencer"
}
