{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/sequencer",
  "version": "0.0.1",
  "description": "A causality-encoding engine written in TypeScript and C++ to build high-performance, conflict-free replicated data types for use on the web.",
  "keywords": [
    "collaborative-editing",
    "crdt"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "configure:wasm": "emcmake cmake --preset wasm-release",
    "build": "npm run build:wasm && npm run build:package",
    "build:package": "tsdown",
    "build:wasm": "node scripts/build-wasm.mjs",
    "docs": "typedoc",
    "docs:c++": "node scripts/build-cpp-docs.mjs",
    "format": "npm run format:ts && npm run format:c++",
    "format:ts": "prettier . --write",
    "format:c++": "node scripts/format-cpp.mjs",
    "typecheck": "tsc --noEmit --project test/tsconfig.json",
    "typecheck:runtime": "tsc --noEmit --project tsconfig.json",
    "test": "npm run build && npm run typecheck && npm run test:vitest && node --test test/compatibility/index.ts",
    "test:vitest": "vitest run --coverage",
    "test:unit": "vitest run test/unit --coverage.enabled=false",
    "test:integration": "vitest run test/integration --coverage.enabled=false",
    "test:convergence": "vitest run test/convergence --coverage.enabled=false",
    "test:stress": "vitest run test/stress --coverage.enabled=false",
    "test:runtimes": "node scripts/run-runtime-tests.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:compatibility": "npm run build:package && node --test test/compatibility/index.ts",
    "bench": "npm run build:package && node benchmark/index.ts",
    "bench:lifecycle": "npm run bench -- --suite lifecycle",
    "bench:throughput": "npm run bench -- --suite throughput",
    "prepare": "husky",
    "prepublishOnly": "npm run test && npm run bench"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.0",
    "@sovereignbase/utils": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "bun": "^1.4.3",
    "deno": "^2.9.6",
    "edge-runtime": "^4.0.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "tinybench": "^6.2.2",
    "tsdown": "^0.23.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0",
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/sequencer.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/sequencer/issues"
  },
  "homepage": "https://sovereignbase.dev/sequencer"
}
