{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/sequencer",
  "version": "0.0.0",
  "description": "A causality-encoding engine written in TypeScript and C++ to build high-performance, conflict-free replicated data types for use on the web.",
  "keywords": [
    "crdt",
    "sequence",
    "replicated",
    "convergent",
    "local-first",
    "distributed-systems",
    "delta-sync",
    "gossip",
    "typescript",
    "sovereignbase"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./wasm": {
      "types": "./wasm/dist/index.d.mts",
      "import": "./wasm/dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "build": "tsdown && typedoc",
    "build:wasm": "cmake --build --preset wasm-release && cmake --install temp/build/wasm-release --prefix src/typescript/wasm/raw && node -e \"const fs=require('node:fs');const p='src/typescript/wasm/raw/sequencer_wasm.mjs';const b=fs.readFileSync(p);const a=Buffer.from('async function Module');const c=Buffer.from('function Module');if(b.subarray(0,a.length).equals(a))fs.writeFileSync(p,Buffer.concat([c,b.subarray(a.length)]))\" && npm run docs:c++",
    "docs:c++": "node scripts/build-cpp-docs.mjs",
    "configure:wasm": "emcmake cmake --preset wasm-release",
    "test": "npm run build:wasm && npm run build && node scripts/run-tests.mjs",
    "test:vitest": "vitest run --coverage",
    "test:unit": "vitest run test/unit --coverage",
    "test:convergence": "vitest run test/convergence --coverage",
    "test:stress": "npm run build && vitest run test/stress --coverage",
    "test:browser": "playwright test",
    "bench": "npm run build && node benchmark/bench.js",
    "prepare": "husky",
    "prepublishOnly": "npm run test && npm run bench"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@sovereignbase/frontier-store": "^1.0.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "deno": "^2.9.4",
    "edge-runtime": "^4.0.1",
    "esbuild": "^0.28.1",
    "fast-check": "^4.9.0",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "terser": "^5.49.0",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/sequencer.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/sequencer/issues"
  },
  "homepage": "https://sovereignbase.dev/sequencer",
  "dependencies": {}
}
