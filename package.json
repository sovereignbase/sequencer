{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/sequencer",
  "version": "0.0.0",
  "description": "A causality-encoding engine written in TypeScript and C++ to build high-performance, conflict-free replicated data types for use on the web.",
  "keywords": [
    "crdt",
    "sequence",
    "replicated",
    "convergent",
    "local-first",
    "distributed-systems",
    "delta-sync",
    "gossip",
    "typescript",
    "sovereignbase"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./wasm": {
      "types": "./src/typescript/wasm/raw/index.d.mts",
      "import": "./src/typescript/wasm/raw/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "build": "tsdown && npm run docs",
    "build:wasm": "cmake --build --preset wasm-release && cmake --install temp/build/wasm-release --prefix src/typescript/wasm/raw && node -e \"const fs=require('node:fs');const p='src/typescript/wasm/raw/sequencer_wasm.mjs';const b=fs.readFileSync(p);const a=Buffer.from('async function Module');const c=Buffer.from('function Module');if(b.subarray(0,a.length).equals(a))fs.writeFileSync(p,Buffer.concat([c,b.subarray(a.length)]))\" && npm run docs:c++",
    "docs": "typedoc",
    "docs:c++": "node scripts/build-cpp-docs.mjs",
    "configure:wasm": "emcmake cmake --preset wasm-release",
    "test": "node scripts/run-tests.mjs",
    "test:vitest": "vitest run --coverage",
    "test:unit": "vitest run test/unit --coverage",
    "test:convergence": "npm run build && npm run build:wasm && vitest run test/convergence --coverage",
    "test:stress": "npm run build && vitest run test/stress --coverage",
    "test:runtimes": "node scripts/run-runtime-tests.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:compare": "",
    "bench": "npm run build:wasm  && npm run build && node --expose-gc --experimental-strip-types benchmarks/index.ts",
    "bench:compare": "npm run build && node --expose-gc --experimental-strip-types benchmarks/index.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run test && npm run bench"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@sovereignbase/utils": "^2.3.0",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "bun": "^1.4.2",
    "deno": "^2.9.6",
    "edge-runtime": "^4.0.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.9.0",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "terser": "^5.51.2",
    "tinybench": "^6.1.6",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/sequencer.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/sequencer/issues"
  },
  "homepage": "https://sovereignbase.dev/sequencer"
}
